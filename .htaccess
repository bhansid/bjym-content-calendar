Options -Indexes
DirectoryIndex index.html
<FilesMatch "^(config|config\.sample|lib|cron)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|lock|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.git.*|SETUP-GUIDE\.txt|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
